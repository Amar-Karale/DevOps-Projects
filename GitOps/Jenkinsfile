@Library('Shared') _

pipeline {
    agent { label 'spy' }

    parameters {
        string(name: 'FRONTEND_DOCKER_TAG', defaultValue: '', description: 'Frontend Docker image tag')
        string(name: 'BACKEND_DOCKER_TAG', defaultValue: '', description: 'Backend Docker image tag')
    }

    stages {
        stage('Validate Parameters') {
            steps {
                script {
                    if (!params.FRONTEND_DOCKER_TAG?.trim() || !params.BACKEND_DOCKER_TAG?.trim()) {
                        error('FRONTEND_DOCKER_TAG and BACKEND_DOCKER_TAG must be provided.')
                    }
                }
            }
        }

        stage('Workspace Cleanup') {
            steps { cleanWs() }
        }

        stage('Git: Code Checkout') {
            steps {
                script {
                    code_checkout('https://github.com/Amar-Karale/DevOps-Projects.git', 'master')
                }
            }
        }

        stage('Update Kubernetes Manifests') {
            steps {
                script {
                    dir('kubernetes') {
                        sh "sed -i 's|image: .*wanderlust-backend-beta:.*|image: amarkarale/wanderlust-backend-beta:${params.BACKEND_DOCKER_TAG}|' backend.yaml"
                        sh "sed -i 's|image: .*wanderlust-frontend-beta:.*|image: amarkarale/wanderlust-frontend-beta:${params.FRONTEND_DOCKER_TAG}|' frontend.yaml"
                    }
                }
            }
        }

        stage('Git: Commit and Push') {
            steps {
                script {
                    withCredentials([gitUsernamePassword(credentialsId: 'github-cred', gitToolName: 'Default')]) {
                        sh '''
                            set -e
                            git config user.name "Jenkins"
                            git config user.email "jenkins@localhost"
                            git add kubernetes/backend.yaml kubernetes/frontend.yaml
                            git diff --cached --quiet || git commit -m "Update Kubernetes image tags"
                            git push origin master
                        '''
                    }
                }
            }
        }
    }
}
